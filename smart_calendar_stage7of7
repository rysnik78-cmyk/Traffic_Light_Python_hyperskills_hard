    def time_object_from_event(self, event):
        time_parser = EVENT_CONSTANTS[event['type']].value['time parser']
        return datetime.datetime.strptime(event['date'], time_parser)

    # verifying the time input from the user;
    # returns time_string verified according to the type o event
    def verified_time_string(self, event_type, prefix = ''):
        while True:
            input_time_string = input(prefix + EVENT_CONSTANTS[event_type].value['time input'])
            try:
                time_object = datetime.datetime.strptime(input_time_string, EVENT_CONSTANTS[event_type].value['time parser'])
            except ValueError:
                print('Incorrect date or time values')
                continue
            if not re.match(EVENT_CONSTANTS[event_type].value['re_pattern'], input_time_string):
                print('Incorrect format')
                continue
            return input_time_string

    # verifying the time input from the user; returns time object
    def verified_time_object(self, input_text, re_pattern, time_pattern):
        while True:
            input_time_string = input(input_text)
            try:
                time_object = datetime.datetime.strptime(input_time_string, time_pattern)
            except ValueError:
                print('Incorrect date or time values')
                continue
            if not re.match(re_pattern, input_time_string):
                print('Incorrect format')
                continue
            return time_object

    # returns tuple day, hour, minute
    def time_left_to_event(self, event_item):
        event_time = self.time_object_from_event(event_item)
        delta = (event_time - datetime.datetime.now()).total_seconds()
        days_left = delta // 86400
        hours_left = delta % 86400 // 3600
        minutes_left = delta % 86400 % 3600 // 60 + 1
        if minutes_left == 60:
            hours_left += 1
            minutes_left = 0
        if hours_left == 24:
            days_left += 1
            hours_left = 0
        return days_left, hours_left, minutes_left, delta


    # counts time left to the birthday next from now
    # returns ready string like this: "Birthday: "Eli Turner (turns 66)" - 308 day(s)"
    def time_left_to_first_available_birthday(self, event_item):
        # counts when is the next birthdays from the reference point in the function defined below
        event_date = self.time_object_from_event(event_item)
        next_birthday = datetime.datetime(datetime.datetime.now().year, event_date.month, event_date.day)
        if datetime.datetime.now().date() >= next_birthday.date():
            next_birthday = datetime.datetime(datetime.datetime.now().year + 1, event_date.month, event_date.day)
        # counting the year turns at next birthday
        year_turns = next_birthday.year - event_date.year
        # counting days to the next birthday
        delta_to_birthday = (next_birthday - datetime.datetime.now()).total_seconds()
        days_left = delta_to_birthday // 86400 + 1  # it could be +1 maybe depends on tests
        return year_turns, days_left, delta_to_birthday, next_birthday

