                    else:
                        prefix = None
                    self.print_single_birthday(self.event_dict[event_key], event_time_object=event_time_object, event_text=event_text, prefix_string=prefix)
                    printed_event_key_list.append(event_key)
                    continue
        if event_type == 'notes' or event_type == 'all':
            # print('N') # test line
            for event_key in self.event_dict.keys():
                if self.event_dict[event_key]['type'] == 'note':
                    printed_events_counter += 1
                    if prefix_string:
                        prefix = str(printed_events_counter) + '. '
                    else:
                        prefix = None
                    self.print_single_event(self.event_dict[event_key], event_time_object=event_time_object, event_text=event_text, prefix_string=prefix)
                    printed_event_key_list.append(event_key)
        return printed_event_key_list

    def main(self):

